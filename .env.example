POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/aicontent
POSTGRES_URI=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/aicontent
JWT_SECRET_KEY=CHANGE_ME
DEBUG=false
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=
# Leave empty to use LLM_MODEL.
LLM_MODEL_FAST=
# Ark content writing/checking uses disabled thinking to keep response budgets useful.
# For non-Ark providers use provider_default unless their protocol supports thinking.
LLM_THINKING_MODE=disabled
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL=
IMAGE_SIZE=1728x2304
MOCK_MODE=false
LOG_PII_ANONYMIZE=true
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
# Applied to new workflows; old checkpoints remain on manual review.
QUALITY_ENABLED=true
QUALITY_MAX_AUTO_PER_REVIEW=1
QUALITY_MAX_AUTO_TOTAL=3
QUALITY_TOKEN_BUDGET=30000
QUALITY_TIMEOUT_SECONDS=45
